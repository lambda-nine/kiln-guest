{
  "boot-source": {
    "boot_args": "console=ttyS0 reboot=k panic=1 pci=off root=/dev/vda rootfstype=squashfs ro init=/init loglevel=3 kiln.test=1 kiln.net=1",
    "kernel_image_path": "/kernel"
  },
  "drives": [
    {
      "drive_id": "rootfs",
      "is_read_only": true,
      "is_root_device": true,
      "path_on_host": "/rootfs"
    },
    {
      "drive_id": "work",
      "is_read_only": false,
      "is_root_device": false,
      "path_on_host": "/work"
    }
  ],
  "machine-config": {
    "huge_pages": "Transparent",
    "mem_size_mib": 768,
    "smt": false,
    "vcpu_count": 1
  },
  "network-interfaces": [
    {
      "guest_mac": "06:00:ac:1e:63:02",
      "host_dev_name": "kgtest0",
      "iface_id": "eth0"
    }
  ]
}
